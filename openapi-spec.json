{
  "openapi":"3.0.1",
  "info":{
    "title":"Payment Service API",
    "description":"Payment service api",
    "version":"v1"
  },
  "servers":[
    {
      "url":"http://localhost:8080",
      "description":"Generated server url"
    }
  ],
  "paths":{
    "/testwebhook":{
      "post":{
        "tags":[
          "webhook-test-controller"
        ],
        "operationId":"receiveWebhook",
        "requestBody":{
          "content":{
            "application/json":{
              "schema":{
                "type":"string"
              }
            }
          },
          "required":true
        },
        "responses":{
          "200":{
            "description":"OK"
          }
        }
      }
    },
    "/api/v1/webhook":{
      "post":{
        "tags":[
          "Webhook"
        ],
        "summary":"Save a new webhook event",
        "description":"This endpoint allows you to save a new webhook event in the system using the data provided in the WebhookDto.",
        "operationId":"saveWebhook",
        "requestBody":{
          "content":{
            "application/json":{
              "schema":{
                "$ref":"#/components/schemas/WebhookDto"
              }
            }
          },
          "required":true
        },
        "responses":{
          "201":{
            "description":"Webhook successfully created",
            "content":{
              "*/*":{
                "schema":{
                  "type":"string"
                }
              }
            }
          },
          "400":{
            "description":"Invalid request, incorrect or missing data",
            "content":{
              "*/*":{
                "schema":{
                  "type":"string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments":{
      "post":{
        "tags":[
          "Payments"
        ],
        "summary":"Create a new payment",
        "description":"This endpoint allows you to create a new payment in the system using the data provided in the PaymentDto.",
        "operationId":"createPayment",
        "requestBody":{
          "content":{
            "application/json":{
              "schema":{
                "$ref":"#/components/schemas/PaymentDto"
              }
            }
          },
          "required":true
        },
        "responses":{
          "201":{
            "description":"Payment successfully created",
            "content":{
              "*/*":{
                "schema":{
                  "type":"string"
                }
              }
            }
          },
          "400":{
            "description":"Invalid request, incorrect or missing data",
            "content":{
              "*/*":{
                "schema":{
                  "type":"string"
                }
              }
            }
          }
        }
      }
    },
    "/dlq/reprocess":{
      "get":{
        "tags":[
          "DLQ"
        ],
        "summary":"Reprocess messages from the Dead Letter Queue",
        "description":"This endpoint allows you to reprocess messages from the Dead Letter Queue (DLQ) that have previously failed processing.",
        "operationId":"listMessages",
        "responses":{
          "500":{
            "description":"Internal server error while reprocessing messages"
          },
          "200":{
            "description":"Messages successfully reprocessed"
          }
        }
      }
    }
  },
  "components":{
    "schemas":{
      "WebhookDto":{
        "required":[
          "endpoint"
        ],
        "type":"object",
        "properties":{
          "endpoint":{
            "type":"string"
          }
        }
      },
      "PaymentDto":{
        "required":[
          "cardNumber",
          "firstName",
          "lastName",
          "zipCode"
        ],
        "type":"object",
        "properties":{
          "firstName":{
            "type":"string"
          },
          "lastName":{
            "type":"string"
          },
          "zipCode":{
            "maxLength":10,
            "minLength":5,
            "type":"string"
          },
          "cardNumber":{
            "type":"string"
          }
        }
      }
    }
  }
}